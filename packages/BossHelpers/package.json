{
  "name": "BossHelpers",
  "version": "2.0.1",
  "title": "Boss helpers: respawn timer and boss finder",
  "description": "Counts down to CKMud's boss respawn (from `uptime`), warns before it, and re-checks after each respawn. `boss find` walks to the nearest boss on the world map, sweeping the map when none is in sight. Type `boss help` for commands.",
  "author": "Bruno Mouta",
  "scripts": [
    {
      "name": "BossHelpers core",
      "file": "src/BossHelpers.lua"
    }
  ],
  "aliases": [
    {
      "name": "boss",
      "regex": "^boss(?:\\s+(\\w+)(?:\\s+(.+))?)?$",
      "script": "if matches[2] == \"update\" then return CKMudUpdate(\"BossHelpers\") end\nlocal function arg(s) if s and s ~= \"\" then return s end end\nBossHelpers.command(arg(matches[2]), arg(matches[3]))"
    }
  ],
  "triggers": [
    {
      "name": "BossHelpers",
      "folder": true,
      "children": [
        {
          "name": "BossHelpers uptime block",
          "patterns": [
            {
              "type": "regex",
              "pattern": "^CKMud System Information:"
            }
          ],
          "script": "BossHelpers.blockStart()"
        },
        {
          "name": "BossHelpers respawn line",
          "patterns": [
            {
              "type": "regex",
              "pattern": "^\\s*Boss Respawn:\\s*(.+?)\\s*remaining"
            }
          ],
          "script": "BossHelpers.onRespawnLine(matches[2])"
        },
        {
          "name": "BossHelpers copyover",
          "patterns": [
            {
              "type": "substring",
              "pattern": "Copyover recovery complete."
            }
          ],
          "script": "BossHelpers.onCopyover()"
        },
        {
          "name": "BossHelpers map lines",
          "patterns": [
            {
              "type": "regex",
              "pattern": "^.*$"
            }
          ],
          "script": "BossHelpers.line(line)"
        }
      ]
    }
  ]
}
