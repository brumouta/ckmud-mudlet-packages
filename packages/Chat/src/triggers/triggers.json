    {
        "name": "Chat Group",
        "isFolder": "yes",
        "children": [
            {
                "name": "gtell",
                "multiline": "yes",
                "multilineDelta": "0",
                "patterns": [
                    {
                        "pattern": "the group, ",
                        "type": "substring"
                    },
                    {
                        "pattern": "^.+? tells? the group, '.+'$",
                        "type": "regex"
                    }
                ]
            },
            {
                "name": "diceroll",
                "multiline": "yes",
                "multilineDelta": "1",
                "patterns": [
                    {
                        "pattern": "three 6 sided di",
                        "type": "substring"
                    },
                    {
                        "pattern": "^.+? rolls? three 6 sided di(?:e|ce).$",
                        "type": "regex"
                    },
                    {
                        "pattern": "Total: ",
                        "type": "substring"
                    }
                ]
            }
        ]
    },
    {
        "name": "Chat Tell",
        "multiline": "yes",
        "multilineDelta": "0",
        "patterns": [
            {
                "pattern": "tell",
                "type": "substring"
            },
            {
                "pattern": "^.+? tells? \\w+?, '.+'$",
                "type": "regex"
            }
        ]
