[
    {
        "name": "autobuff on off",
        "regex": "^autobuff (on|off)$"
    },
    {
        "name": "autobuff add",
        "regex": "^autobuff add (.+)$"
    },
    {
        "name": "autobuff remove",
        "regex": "^autobuff remove (.+)$"
    },
    {
        "name": "autobuff newbuff",
        "regex": "^autobuff newbuff (.+) :: (.+)$"
    },
    {
        "name": "autobuff delbuff",
        "regex": "^autobuff delbuff (.+)$"
    },
    {
        "name": "autobuff buffs",
        "regex": "^autobuff buffs$"
    },
    {
        "name": "autobuff settag",
        "regex": "^autobuff settag (.+) (.+)$"
    },
    {
        "name": "autobuff setcast",
        "regex": "^autobuff setcast (.+) :: (.+)$"
    },
    {
        "name": "autobuff setaffects",
        "regex": "^autobuff setaffects (.+) :: (.+)$"
    },
    {
        "name": "autobuff setcmd",
        "regex": "^autobuff setcmd (.+) :: (.+)$"
    },
    {
        "name": "autobuff setitem",
        "regex": "^autobuff setitem (.+) :: (.+) :: (.+)$"
    },
    {
        "name": "autobuff combat",
        "regex": "^autobuff combat (.+)$"
    },
    {
        "name": "autobuff cast",
        "regex": "^autobuff cast$"
    },
    {
        "name": "autobuff help",
        "regex": "^autobuff help$"
    },
    {
        "name": "autobuff",
        "regex": "^autobuff(?:\\s+list)?$"
    },
    {
        "name": "buffwnd",
        "regex": "^buffwnd(?:\\s+(show|hide|float))?$"
    }
]
