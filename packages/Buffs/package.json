    },
    {
      "name": "autobuff",
      "regex": "^autobuff(?:\\s+list)?$",
      "file": "src/aliases/autobuff.lua"
    },
    {
      "name": "buffwnd",
      "regex": "^buffwnd(?:\\s+(show|hide|float))?$",
      "file": "src/aliases/buffwnd.lua"
    }
  ],
